# Скопируйте в .env и замените значения.
# Минимум 32 символа. Для генерации: python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# Опционально: URL SQLite или PostgreSQL
# DATABASE_URL=sqlite:///./movie_library.db

# Список origin для CORS (через запятую, без пробелов вокруг или с trim)
# BACKEND_CORS_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:8000,http://localhost:8000
